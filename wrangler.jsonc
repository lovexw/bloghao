// 博客号 BlogHao —— Cloudflare Workers 配置
// 部署前需要把下面 d1_databases 的 database_id 换成你自己的，详见 docs/DEPLOY.md
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bloghao-blog",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",

  // 静态资源目录（后台 SPA / 插件 / favicon），其余请求进入 Worker
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  // 主题 CSS 以文本形式打进 Worker，随页面内联输出（零额外请求）
  "rules": [{ "type": "Text", "globs": ["**/*.css"] }],

  // D1 数据库：wrangler d1 create bloghao-db 后，把返回的 database_id 填到这里
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bloghao-db",
      "database_id": "182e6b3f-1eaf-4bd7-974c-628ab62bc0eb"
    }
  ],

  // R2 存储桶（图床）：wrangler r2 bucket create bloghao-images
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "bloghao-images" }],

  "observability": { "enabled": true }
}
