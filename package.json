{
  "name": "xwblog",
  "version": "1.0.0",
  "private": true,
  "description": "xwblog —— 基于博客号 BlogHao 二次开发的个人博客系统（Workers + D1 + R2）",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:site": "wrangler deploy --config website/wrangler.jsonc",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "db:init:local": "wrangler d1 execute DB --local --file schema.sql",
    "db:init:remote": "wrangler d1 execute DB --remote --file schema.sql"
  },
  "dependencies": {
    "hono": "^4.9.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "typescript": "^5.6.3",
    "wrangler": "^4.81.1"
  },
  "engines": {
    "node": ">=18"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20261001.1": true,
    "fsevents@2.3.3": true
  }
}
