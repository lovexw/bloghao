{
  "name": "bloghao",
  "version": "1.0.0",
  "private": true,
  "description": "博客号 BlogHao —— 微信有公众号，你有博客号。完全住在 Cloudflare 上的轻写作博客系统（Workers + D1 + R2）",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:site": "wrangler deploy --config website/wrangler.jsonc",
    "typecheck": "tsc --noEmit",
    "db:init:local": "wrangler d1 execute DB --local --file schema.sql",
    "db:init:remote": "wrangler d1 execute DB --remote --file schema.sql"
  },
  "dependencies": {
    "hono": "^4.9.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "typescript": "^5.6.3",
    "wrangler": "^4.81.1"
  },
  "engines": {
    "node": ">=18"
  }
}
